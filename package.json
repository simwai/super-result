{
  "name": "super-result",
  "version": "0.1.0",
  "description": "Lightweight railway-oriented error handling for TypeScript — discriminated Result<T,E>, typed async, zero unsafe casts, composable logging & tracing.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "biome check src",
    "format": "biome check --write src",
    "type-check": "tsc --noEmit",
    "check": "pnpm docs:generate && pnpm exec concurrently \"pnpm check-quality\" \"pnpm lint\" \"pnpm type-check\"",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean && bash -c \"cp ./LICENSE ./dist && cp ./README.md ./dist\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check-quality": "knip && madge --orphans --leaves --circular --tsconfig ./tsconfig.json",
    "docs:generate": "typedoc",
    "version:patch": "pnpm version patch",
    "version:minor": "pnpm version minor",
    "version:major": "pnpm version major",
    "preversion": "pnpm run build && pnpm run test",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "postversion": "pnpm publish --access public --ignore-scripts"
  },
  "keywords": [
    "result",
    "railway",
    "error-handling",
    "typescript",
    "neverthrow",
    "functional",
    "async"
  ],
  "author": "simwai",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@vitest/coverage-v8": "^4.1.6",
    "concurrently": "^9.2.1",
    "tsup": "^8.4.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
