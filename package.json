{
  "name": "super-result",
  "version": "1.4.0",
  "description": "Lightweight railway-oriented error handling for TypeScript — discriminated Result<T,E>, typed async, zero unsafe casts, composable logging & tracing.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "lint": "biome check src",
    "format": "biome check --write src",
    "type-check": "tsc --noEmit",
    "check": "pnpm concurrently \"pnpm docs:generate\" \"pnpm lint\" \"pnpm type-check\"",
    "dev": "unbuild --stub",
    "build": "unbuild && bash -c \"cp ./LICENSE ./dist && cp ./README.md ./dist\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:generate": "typedoc",
    "version:patch": "pnpm version patch",
    "version:minor": "pnpm version minor",
    "version:major": "pnpm version major",
    "preversion": "pnpm run build && pnpm run test",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "postversion": "pnpm publish --access public --ignore-scripts",
    "prepare": "husky"
  },
  "keywords": [
    "result",
    "railway",
    "error-handling",
    "typescript",
    "neverthrow",
    "functional",
    "async"
  ],
  "author": "simwai",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@vitest/coverage-v8": "^4.1.6",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "tsup": "^8.4.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.8.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.6"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "super-result": "link:"
  }
}
